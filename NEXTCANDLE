<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Next Candle — Trading Community</title>

  <meta name="description"
        content="Next Candle is a modern trading community focused on education, market structure, liquidity, risk management and disciplined execution.">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #050706;
      color: #f4f7f5;
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    nav {
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid #18201b;
    }

    .logo {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -1px;
    }

    .logo span {
      color: #39e878;
    }

    .nav-links {
      display: flex;
      gap: 28px;
      color: #aab4ad;
      font-size: 14px;
    }

    .nav-links a:hover {
      color: white;
    }

    .nav-button {
      background: #39e878;
      color: #041007;
      padding: 11px 18px;
      border-radius: 9px;
      font-weight: 700;
      font-size: 14px;
    }

    .hero {
      min-height: 650px;
      display: flex;
      align-items: center;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 600px;
      height: 600px;
      background: #39e878;
      opacity: 0.08;
      filter: blur(120px);
      border-radius: 50%;
      left: 50%;
      top: 40%;
      transform: translate(-50%, -50%);
    }

    .hero-content {
      position: relative;
      z-index: 2;
      width: 100%;
    }

    .badge {
      display: inline-block;
      border: 1px solid #26342b;
      background: #0b100d;
      color: #7df2a3;
      padding: 8px 14px;
      border-radius: 999px;
      font-size: 13px;
      margin-bottom: 25px;
    }

    h1 {
      font-size: clamp(48px, 8vw, 92px);
      line-height: 0.95;
      letter-spacing: -5px;
      max-width: 900px;
      margin: auto;
    }

    h1 span {
      color: #39e878;
    }

    .hero p {
      max-width: 650px;
      margin: 28px auto;
      color: #9ca79f;
      font-size: 18px;
    }

    .buttons {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .primary {
      background: #39e878;
      color: #041007;
      padding: 15px 25px;
      border-radius: 10px;
      font-weight: 800;
    }

    .secondary {
      border: 1px solid #29352e;
      background: #0b0f0c;
      padding: 15px 25px;
      border-radius: 10px;
      font-weight: 700;
    }

    .secondary:hover {
      border-color: #39e878;
    }

    section {
      padding: 100px 0;
    }

    .section-title {
      text-align: center;
      max-width: 650px;
      margin: auto;
    }

    .section-title h2 {
      font-size: 42px;
      letter-spacing: -2px;
      margin-bottom: 15px;
    }

    .section-title p {
      color: #89948c;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 55px;
    }

    .card {
      background: #090d0a;
      border: 1px solid #1b251f;
      border-radius: 16px;
      padding: 28px;
      transition: 0.25s;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: #31523c;
    }

    .icon {
      font-size: 27px;
      margin-bottom: 20px;
    }

    .card h3 {
      margin-bottom: 9px;
    }

    .card p {
      color: #879189;
      font-size: 14px;
    }

    .pricing {
      max-width: 500px;
      margin: 55px auto 0;
      background: #090d0a;
      border: 1px solid #253229;
      border-radius: 20px;
      padding: 35px;
      text-align: center;
    }

    .pricing h3 {
      font-size: 28px;
    }

    .price {
      font-size: 45px;
      font-weight: 800;
      margin: 15px 0;
    }

    .price span {
      font-size: 15px;
      color: #78847c;
      font-weight: normal;
    }

    .features {
      list-style: none;
      text-align: left;
      margin: 25px 0;
    }

    .features li {
      padding: 9px 0;
      color: #b6c0b9;
    }

    .features li::before {
      content: "✓";
      color: #39e878;
      margin-right: 10px;
    }

    .full-button {
      display: block;
      background: #39e878;
      color: #041007;
      padding: 15px;
      border-radius: 10px;
      font-weight: 800;
    }

    .community {
      background: #080c09;
      border-top: 1px solid #18211b;
      border-bottom: 1px solid #18211b;
      text-align: center;
    }

    footer {
      padding: 35px 0;
      color: #69736c;
      font-size: 13px;
      text-align: center;
    }

    @media (max-width: 750px) {
      .nav-links {
        display: none;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      h1 {
        letter-spacing: -3px;
      }

      section {
        padding: 70px 0;
      }
    }
  </style>
</head>

